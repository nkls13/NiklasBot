# Discord
DISCORD_TOKEN=your_discord_bot_token_here
APPLICATION_ID=your_discord_application_id_here

# Groq (free tier) — chat completions + transcription
# Sign up at console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenAI — used only for TTS (text-to-speech)
# Sign up at platform.openai.com
OPENAI_API_KEY=sk_your_openai_api_key_here

# Fortnite API (optional) — improves cosmetics data quality
# Sign up at fortnite-api.com
FORTNITE_API_KEY=your_fortnite_api_key_here
